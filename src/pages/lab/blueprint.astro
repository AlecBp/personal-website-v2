---
import { Picture } from 'astro:assets';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Lab from '../../lab/Lab.astro';
import { loadSite } from '../../lab/data';
import portrait from '../../assets/profile.jpeg';

const { p, About, experience, work, earlier } = await loadSite();
const months: Record<string, string> = { Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06', Jul: '07', Aug: '08', Sep: '09', Oct: '10', Nov: '11', Dec: '12' };
const stamp = (d: string) => (d === 'Present' ? 'NOW' : `${d.split(' ')[1]}.${months[d.split(' ')[0]]}`);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Lab title="Blueprint">
  <div class="sheet">
    <div class="ruler" aria-hidden="true">
      {['A', 'B', 'C', 'D', 'E', 'F'].map((l) => <span>{l}</span>)}
    </div>

    <header class="hero">
      <div class="hero-main">
        <p class="label">DWG. 001 / Personal site / Rev. 2026.09</p>
        <h1>{p.name}</h1>
        <p class="tagline">{p.tagline}</p>
      </div>
      <figure class="portrait">
        <div class="frame">
          <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
          <Picture src={portrait} alt={`Portrait of ${p.name}`} width={220} height={220} widths={[220, 440]} sizes="220px" formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" />
        </div>
        <figcaption class="label">Fig. 1 — Portrait</figcaption>
      </figure>
      <dl class="title-block">
        <div><dt>Title</dt><dd>{p.jobTitle}</dd></div>
        <div><dt>Organisation</dt><dd>{p.employer}</dd></div>
        <div><dt>Location</dt><dd>{p.location}</dd></div>
        <div class="links">
          <a href={p.resume}>Resume <span aria-hidden="true">↗</span></a>
          <a href={p.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </dl>
    </header>

    <section>
      <h2 class="section-title"><span>01</span> About</h2>
      <div class="about">
        <div class="prose"><About /></div>
        <aside class="notes">
          <p class="label">Notes</p>
          <ol>
            <li>{p.education}</li>
            <li>IEEEXtreme 2020 — 11th in Canada.</li>
            <li>Based in {p.location}.</li>
          </ol>
        </aside>
      </div>
    </section>

    <section>
      <h2 class="section-title"><span>02</span> Selected work</h2>
      <ul class="components">
        {
          work.map((w, i) => (
            <li class="component">
              <span class="tag">C-{pad(i + 1)}</span>
              <h3>{w.title}</h3>
              <p>{w.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="section-title"><span>03</span> Experience</h2>
      <ol class="log">
        {
          experience.map((r) => (
            <li>
              <div class="span-col">
                <span class="stamp">{stamp(r.end)}</span>
                <span class="dim" aria-hidden="true" />
                <span class="stamp">{stamp(r.start)}</span>
              </div>
              <div>
                <p class="label">{r.company} / {r.team}</p>
                <h3>{r.title}</h3>
                <div class="bullets"><r.Content /></div>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="label earlier-title">Earlier</p>
      <ul class="earlier">{earlier.map((e) => <li>{e}</li>)}</ul>
    </section>

    <section>
      <h2 class="section-title"><span>04</span> Contact</h2>
      <dl class="contact">
        <div><dt>Email</dt><dd><a href="#">{p.email.replace('@', ' [at] ')}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={p.links.linkedin}>linkedin.com/in/alecbp</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={p.links.github}>github.com/AlecBp</a></dd></div>
      </dl>
    </section>

    <footer class="label">© 2026 {p.name} — Drawn with Astro — Sheet 1 of 1</footer>
  </div>
</Lab>

<style is:global>
  :root {
    --paper: #f2f4f6;
    --ink: #10263f;
    --muted: #4a5b6e;
    --rule: rgb(16 38 63 / 0.22);
    --accent: #c2410c;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --sans: 'Archivo Variable', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--ink);
    font: 400 1.0625rem/1.65 var(--sans);
    background-color: var(--paper);
    background-image:
      linear-gradient(rgb(16 38 63 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 38 63 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--accent); }
  h1, h2, h3, p, ul, ol, dl, dd, figure { margin: 0; }
  .label { font: 500 0.75rem/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  .sheet {
    max-width: 72rem;
    margin: clamp(0.75rem, 3vw, 2.5rem) auto;
    border: 1.5px solid var(--ink);
    background: rgb(242 244 246 / 0.7);
    padding: 0 clamp(1.25rem, 4vw, 3rem) 2rem;
  }
  .ruler { display: flex; justify-content: space-around; border-bottom: 1px solid var(--rule); margin: 0 calc(-1 * clamp(1.25rem, 4vw, 3rem)); font: 500 0.6875rem var(--mono); color: var(--muted); padding: 0.35rem 0; }

  .hero { display: grid; gap: 2rem; padding: clamp(2rem, 6vw, 4.5rem) 0 0; }
  @media (min-width: 52rem) { .hero { grid-template-columns: 1fr 15rem; column-gap: 3rem; } .title-block { grid-column: 1 / -1; } }
  h1 {
    font-weight: 750;
    font-stretch: 125%;
    font-size: clamp(2.6rem, 1rem + 6.5vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-top: 1rem;
  }
  .tagline { margin-top: 1.5rem; font-size: 1.25rem; max-width: 34em; }
  .portrait { align-self: start; justify-self: start; }
  .frame { position: relative; padding: 12px; }
  .portrait img { width: 220px; height: 220px; object-fit: cover; filter: grayscale(0); display: block; border: 1px solid var(--ink); }
  .portrait figcaption { margin-top: 0.6rem; }
  .tick { position: absolute; width: 14px; height: 14px; border-color: var(--accent); border-style: solid; border-width: 0; }
  .tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
  .tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
  .br { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }

  .title-block { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); border: 1.5px solid var(--ink); margin-top: 1rem; }
  .title-block > div { padding: 0.75rem 1rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .title-block dt { font: 500 0.6875rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .title-block dd { font-weight: 600; font-stretch: 110%; margin-top: 0.2rem; }
  .title-block .links { display: flex; gap: 0.5rem; align-items: center; padding: 0.6rem; }
  .title-block .links a { flex: 1; text-align: center; font: 500 0.8125rem var(--mono); text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; border: 1px solid var(--ink); padding: 0.55rem 0.5rem; }
  .title-block .links a:first-child { background: var(--ink); color: var(--paper); }
  .title-block .links a:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  section { padding-top: clamp(3rem, 7vw, 5rem); }
  .section-title { display: flex; align-items: center; gap: 0.75rem; font: 500 0.8125rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 2rem; }
  .section-title span { color: var(--accent); }
  .section-title::after { content: ''; flex: 1; border-top: 1px solid var(--ink); }

  .about { display: grid; gap: 2rem; }
  @media (min-width: 52rem) { .about { grid-template-columns: minmax(0, 40rem) 1fr; column-gap: 3rem; } }
  .prose p + p { margin-top: 1em; }
  .notes { border-left: 1.5px solid var(--accent); padding-left: 1rem; align-self: start; }
  .notes ol { margin-top: 0.75rem; padding-left: 1.2rem; font-size: 0.9375rem; color: var(--muted); display: grid; gap: 0.5rem; }

  .components { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 44rem) { .components { grid-template-columns: 1fr 1fr; } }
  .component { position: relative; border: 1px solid var(--ink); background: var(--paper); padding: 2.25rem 1.5rem 1.5rem; }
  .component .tag { position: absolute; top: -1px; left: -1px; background: var(--ink); color: var(--paper); font: 500 0.75rem var(--mono); padding: 0.25rem 0.6rem; letter-spacing: 0.06em; }
  .component h3 { font-weight: 650; font-stretch: 112%; font-size: 1.3rem; line-height: 1.2; }
  .component p { margin-top: 0.6rem; color: var(--muted); }

  .log { list-style: none; padding: 0; display: grid; gap: 2.5rem; }
  .log > li { display: grid; gap: 0.75rem; }
  .span-col { display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: center; gap: 0.5rem; font: 500 0.75rem var(--mono); color: var(--accent); }
  .dim { width: 3rem; height: 1px; background: var(--accent); position: relative; }
  .dim::before, .dim::after { content: ''; position: absolute; top: -4px; height: 9px; border-left: 1px solid var(--accent); }
  .dim::before { left: 0; } .dim::after { right: 0; }
  @media (min-width: 44rem) {
    .log > li { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1.25rem; }
    .span-col { flex-direction: column; justify-content: flex-start; gap: 0; }
    .dim { flex: 1; width: 1px; height: auto; margin: 0.4rem 0; min-height: 3rem; }
    .dim::before, .dim::after { top: auto; left: -4px; right: auto; height: 0; width: 9px; border-left: 0; border-top: 1px solid var(--accent); }
    .dim::before { top: 0; } .dim::after { bottom: 0; }
  }
  .log h3 { font-weight: 650; font-stretch: 112%; font-size: 1.35rem; margin-top: 0.3rem; }
  .bullets ul { padding-left: 1.1rem; margin-top: 0.75rem; display: grid; gap: 0.5rem; }
  .bullets li::marker { content: '▸  '; color: var(--accent); font-size: 0.8em; }
  .earlier-title { margin-top: 3rem; }
  .earlier { list-style: none; padding: 0; margin-top: 0.75rem; border-top: 1px solid var(--rule); font-size: 0.9375rem; color: var(--muted); }
  .earlier li { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }

  .contact { border: 1.5px solid var(--ink); }
  .contact div { display: grid; grid-template-columns: 7rem 1fr; border-bottom: 1px solid var(--rule); }
  .contact div:last-child { border-bottom: 0; }
  .contact dt { font: 500 0.75rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; padding: 1rem; border-right: 1px solid var(--rule); color: var(--muted); }
  .contact dd { padding: 0.8rem 1rem; font-weight: 600; font-stretch: 110%; font-size: 1.15rem; }
  footer { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--ink); }
</style>
