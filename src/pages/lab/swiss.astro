---
import { Picture } from 'astro:assets';
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/instrument-sans/index.css';
import Lab from '../../lab/Lab.astro';
import { loadSite } from '../../lab/data';
import portrait from '../../assets/profile.jpeg';

const { p, About, experience, work, earlier } = await loadSite();
const [first, ...rest] = p.name.split(' ');
const year = (d: string) => (d === 'Present' ? 'Now' : d.split(' ')[1]);
---

<Lab title="Swiss poster">
  <header class="topbar wrap">
    <span>{p.name}</span>
    <nav><a href="#work">Work</a><a href="#experience">Experience</a><a href="#contact">Contact</a></nav>
  </header>

  <section class="hero wrap">
    <h1><span>{first}</span><span>{rest.join(' ')}</span></h1>
    <div class="hero-grid">
      <p class="role"><strong>{p.jobTitle}</strong> at {p.employer}<br />{p.location}</p>
      <p class="tagline">{p.tagline}</p>
      <Picture class="photo" pictureAttributes={{ class: 'photo-wrap' }} src={portrait} alt={`Portrait of ${p.name}`} width={320} height={320} widths={[320, 640]} sizes="(min-width: 60rem) 320px, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" />
      <div class="actions">
        <a class="solid" href={p.resume}>Resume</a>
        <a href={p.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="block wrap">
    <p class="num">01</p>
    <div class="body">
      <h2>About</h2>
      <div class="prose"><About /></div>
    </div>
  </section>

  <section id="work" class="block wrap">
    <p class="num">02</p>
    <div class="body">
      <h2>Selected work</h2>
      <ol class="work">
        {work.map((w, i) => (
          <li>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{w.title}</h3>
            <p>{w.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="experience" class="block wrap">
    <p class="num">03</p>
    <div class="body">
      <h2>Experience</h2>
      <ol class="roles">
        {experience.map((r) => (
          <li>
            <p class="years">{year(r.start)}–{year(r.end)}</p>
            <div>
              <h3>{r.title}</h3>
              <p class="org">{r.company} · {r.team}</p>
              <div class="bullets"><r.Content /></div>
            </div>
          </li>
        ))}
      </ol>
      <p class="earlier"><strong>Earlier.</strong> {earlier.join(' / ')}</p>
    </div>
  </section>

  <section id="contact" class="contact wrap">
    <p class="num">04</p>
    <div class="body">
      <h2>Contact</h2>
      <a class="mail" href="#">{p.email.replace('@', '@​')}</a>
      <p class="more"><a href={p.links.linkedin}>LinkedIn</a> <a href={p.links.github}>GitHub</a> <a href={p.resume}>Resume</a></p>
    </div>
  </section>

  <footer class="wrap">© 2026 {p.name}. Built with Astro.</footer>
</Lab>

<style is:global>
  :root {
    --bg: #f7f6f2;
    --ink: #111111;
    --muted: #55534e;
    --accent: #d7340f;
    --display: 'Bricolage Grotesque Variable', 'Helvetica Neue', Arial, sans-serif;
    --text: 'Instrument Sans Variable', 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.6 var(--text); }
  h1, h2, h3, p, ol, ul { margin: 0; }
  a { color: inherit; }
  a:hover { color: var(--accent); }
  .wrap { max-width: 90rem; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 3rem); }

  .topbar { display: flex; justify-content: space-between; align-items: baseline; padding-block: 1.25rem; font-weight: 600; font-size: 0.9375rem; border-bottom: 6px solid var(--ink); }
  .topbar nav { display: flex; gap: 1.25rem; }
  .topbar a { text-decoration: none; }

  .hero { padding-top: clamp(1rem, 3vw, 2rem); }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(3.4rem, 15.5vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
    margin-left: -0.05em;
  }
  h1 span { display: block; }
  h1 span:last-child { color: var(--accent); }

  .hero-grid { display: grid; gap: 1.5rem; margin-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 2px solid var(--ink); }
  .role { font-size: 1.125rem; line-height: 1.45; }
  .tagline { font-family: var(--display); font-weight: 500; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.25rem); line-height: 1.15; letter-spacing: -0.02em; }
  .photo-wrap { display: block; width: 100%; max-width: 320px; }
  .photo { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .actions { display: flex; gap: 0.5rem; align-self: end; }
  .actions a { font-weight: 600; text-decoration: none; padding: 0.8rem 1.4rem; border: 2px solid var(--ink); }
  .actions a.solid { background: var(--ink); color: var(--bg); }
  .actions a:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  @media (min-width: 60rem) {
    .hero-grid { grid-template-columns: repeat(12, 1fr); column-gap: 1.5rem; align-items: start; }
    .role { grid-column: 1 / span 3; grid-row: 1; }
    .tagline { grid-column: 4 / span 6; grid-row: 1 / span 2; }
    .photo-wrap { grid-column: 10 / span 3; grid-row: 1 / span 2; justify-self: end; }
    .actions { grid-column: 1 / span 3; grid-row: 2; }
  }

  .block, .contact { display: grid; gap: 1rem; padding-block: clamp(3rem, 7vw, 6rem); border-bottom: 2px solid var(--ink); }
  .num { font-family: var(--display); font-weight: 800; font-size: clamp(4rem, 10vw, 9rem); line-height: 0.8; letter-spacing: -0.06em; color: var(--accent); }
  h2 { font-family: var(--display); font-weight: 700; font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); letter-spacing: -0.03em; line-height: 1; margin-bottom: 2rem; }
  @media (min-width: 60rem) {
    .block, .contact { grid-template-columns: repeat(12, 1fr); column-gap: 1.5rem; }
    .num { grid-column: 1 / span 3; }
    .body { grid-column: 4 / span 8; }
  }
  .prose { max-width: 40em; }
  .prose p + p { margin-top: 1em; }
  .prose p:first-child { font-size: 1.25rem; line-height: 1.5; }

  .work { list-style: none; padding: 0; display: grid; gap: 2rem 1.5rem; }
  @media (min-width: 44rem) { .work { grid-template-columns: 1fr 1fr; } }
  .work li { border-top: 3px solid var(--ink); padding-top: 1rem; }
  .idx { font-family: var(--display); font-weight: 800; font-size: 1rem; color: var(--accent); }
  .work h3 { font-family: var(--display); font-weight: 700; font-size: 1.5rem; line-height: 1.1; letter-spacing: -0.02em; margin: 0.4rem 0 0.6rem; }
  .work p { color: var(--muted); }

  .roles { list-style: none; padding: 0; }
  .roles > li { display: grid; gap: 0.5rem 1.5rem; padding-block: 1.75rem; border-top: 1px solid var(--ink); }
  @media (min-width: 44rem) { .roles > li { grid-template-columns: 9rem 1fr; } }
  .years { font-family: var(--display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .roles h3 { font-family: var(--display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; line-height: 1.1; }
  .org { color: var(--muted); font-weight: 500; margin-top: 0.2rem; }
  .bullets ul { padding-left: 1.1rem; margin-top: 0.9rem; display: grid; gap: 0.45rem; }
  .bullets li::marker { color: var(--accent); }
  .earlier { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--ink); color: var(--muted); font-size: 0.9375rem; }
  .earlier strong { color: var(--ink); }

  .mail { display: block; font-family: var(--display); font-weight: 700; font-size: clamp(1.75rem, 1rem + 4vw, 4.5rem); letter-spacing: -0.04em; line-height: 1; text-decoration: none; overflow-wrap: anywhere; }
  .more { display: flex; gap: 1.5rem; margin-top: 1.5rem; font-weight: 600; }
  footer { padding-block: 2rem; font-size: 0.875rem; color: var(--muted); }
</style>
