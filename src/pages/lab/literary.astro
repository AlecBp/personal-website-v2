---
import { Picture } from 'astro:assets';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/newsreader/index.css';
import Lab from '../../lab/Lab.astro';
import { loadSite } from '../../lab/data';
import portrait from '../../assets/profile.jpeg';

const { p, About, experience, work, writing, earlier } = await loadSite();
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const year = (d: string) => (d === 'Present' ? 'present' : d.split(' ')[1]);
---

<Lab title="Literary">
  <main class="page">
    <header class="masthead">
      <p class="kicker">The personal pages of</p>
      <h1>Alec <em>Pagliarussi</em></h1>
      <p class="dek">{p.jobTitle} at {p.employer} · {p.location}</p>
      <div class="ornament" aria-hidden="true">❦</div>
    </header>

    <section class="opening">
      <Picture class="portrait" src={portrait} alt={`Portrait of ${p.name}`} width={200} height={250} widths={[200, 400]} sizes="200px" formats={['avif', 'webp']} fallbackFormat="jpg" position="top" fit="cover" loading="eager" />
      <p class="lede">{p.tagline}</p>
      <p class="links"><a href={p.resume}>Read the résumé</a> <span aria-hidden="true">·</span> <a href={p.links.linkedin}>LinkedIn</a></p>
    </section>

    <section>
      <h2><span>§ 1</span> About</h2>
      <div class="prose dropcap"><About /></div>
    </section>

    <section>
      <h2><span>§ 2</span> Selected work</h2>
      <ol class="work">
        {work.map((w, i) => (
          <li>
            <span class="numeral">{roman[i]}.</span>
            <div>
              <h3>{w.title}</h3>
              <p>{w.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2><span>§ 3</span> Experience</h2>
      <ol class="roles">
        {experience.map((r) => (
          <li>
            <p class="leader"><span class="title">{r.title}, <em>{r.company}</em></span><span class="dots" aria-hidden="true"></span><span class="years">{year(r.start)}–{year(r.end)}</span></p>
            <p class="team">{r.team}</p>
            <div class="bullets"><r.Content /></div>
          </li>
        ))}
      </ol>
      <p class="aside"><span class="smallcaps">Earlier</span> — {earlier.join('; ')}.</p>
    </section>

    <section>
      <h2><span>§ 4</span> Talks</h2>
      <ul class="talks">{writing.map((w) => <li><em>{w.title}</em> — {w.venue}</li>)}</ul>
    </section>

    <section class="closing">
      <h2><span>§ 5</span> Correspondence</h2>
      <p>Letters are welcome at <a href="#">{p.email}</a>. I can also be found on <a href={p.links.linkedin}>LinkedIn</a> and <a href={p.links.github}>GitHub</a>.</p>
      <div class="ornament" aria-hidden="true">⁂</div>
      <p class="colophon">Set in Fraunces and Newsreader. Built with Astro, 2026.</p>
    </section>
  </main>
</Lab>

<style is:global>
  :root {
    --paper: #f5efe4;
    --ink: #2b2420;
    --muted: #6b5e54;
    --rule: #d9cdbb;
    --accent: #8c2f23;
    --display: 'Fraunces Variable', Georgia, serif;
    --text: 'Newsreader Variable', Georgia, serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1.1875rem/1.62 var(--text); font-variation-settings: 'opsz' 16; }
  h1, h2, h3, p, ol, ul { margin: 0; }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:hover { color: var(--ink); }
  .page { max-width: 42rem; margin-inline: auto; padding: clamp(2.5rem, 8vw, 6rem) clamp(1.25rem, 5vw, 2rem) 4rem; }

  .masthead { text-align: center; }
  .kicker { font-variant: all-small-caps; letter-spacing: 0.12em; color: var(--muted); font-size: 1.05rem; }
  h1 {
    font-family: var(--display);
    font-weight: 380;
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
    font-size: clamp(3rem, 1.5rem + 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  h1 em { font-style: italic; color: var(--accent); font-weight: 340; }
  .dek { margin-top: 1rem; font-style: italic; color: var(--muted); }
  .ornament { margin: 2rem 0; text-align: center; color: var(--accent); font-size: 1.5rem; }

  .opening { display: grid; gap: 1.5rem; justify-items: center; text-align: center; }
  .portrait { width: 200px; height: 250px; border-radius: 100px / 125px; object-fit: cover; box-shadow: 0 0 0 1px var(--rule), 0 0 0 7px var(--paper), 0 0 0 8px var(--rule); }
  .lede { font-family: var(--display); font-weight: 350; font-variation-settings: 'opsz' 48, 'SOFT' 100; font-size: clamp(1.4rem, 1.1rem + 1vw, 1.75rem); line-height: 1.35; max-width: 30em; text-wrap: balance; }
  .links { font-variant: all-small-caps; letter-spacing: 0.1em; font-size: 1.1rem; }

  section { margin-top: clamp(3.5rem, 8vw, 5.5rem); }
  h2 { font-family: var(--display); font-weight: 450; font-variation-settings: 'opsz' 72; font-size: 1.9rem; letter-spacing: -0.01em; margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 0.75rem; }
  h2 span { font-family: var(--text); font-size: 1rem; color: var(--accent); font-style: italic; }
  h2::after { content: ''; flex: 1; border-bottom: 1px solid var(--rule); transform: translateY(-0.3em); }

  .prose p + p { margin-top: 0; text-indent: 1.5em; }
  .dropcap p:first-child::first-letter { font-family: var(--display); float: left; font-size: 4.1em; line-height: 0.8; padding: 0.08em 0.1em 0 0; color: var(--accent); font-variation-settings: 'opsz' 144, 'SOFT' 100; }

  .work { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .work li { display: grid; grid-template-columns: 2.75rem 1fr; }
  .numeral { font-family: var(--display); font-style: italic; color: var(--accent); font-size: 1.25rem; }
  .work h3 { font-family: var(--display); font-weight: 500; font-size: 1.3rem; line-height: 1.25; font-variation-settings: 'opsz' 36; }
  .work p { color: var(--muted); margin-top: 0.2rem; }

  .roles { list-style: none; padding: 0; display: grid; gap: 2rem; }
  .leader { display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--display); font-size: 1.2rem; font-variation-settings: 'opsz' 36; }
  .leader .title { font-weight: 500; }
  .leader em { font-weight: 400; }
  .dots { flex: 1; border-bottom: 2px dotted var(--rule); transform: translateY(-0.25em); min-width: 1rem; }
  .years { font-variant-numeric: oldstyle-nums; color: var(--muted); white-space: nowrap; font-size: 1.05rem; }
  .team { font-style: italic; color: var(--muted); font-size: 1rem; }
  .bullets ul { padding-left: 1.2rem; margin-top: 0.6rem; display: grid; gap: 0.35rem; }
  .bullets li::marker { content: '— '; color: var(--rule); }
  .aside { margin-top: 2rem; font-size: 1.02rem; color: var(--muted); }
  .smallcaps { font-variant: all-small-caps; letter-spacing: 0.1em; color: var(--ink); }

  .talks { padding-left: 1.2rem; }
  .closing { text-align: left; }
  .colophon { text-align: center; font-style: italic; color: var(--muted); font-size: 0.95rem; }
</style>
