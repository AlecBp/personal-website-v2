---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Expertise from '../components/Expertise.astro';
import Route from '../components/Route.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('src/content/profile.md is missing');
const { data } = profile;
---

<Base profilePage>
  <div class="wrap">
    <Intro
      name={data.name}
      jobTitle={data.jobTitle}
      employer={data.employer}
      intro={data.intro}
      workLocation={data.workLocation}
      portrait={data.portrait}
      resume={data.resume}
      email={data.email}
      linkedin={data.links.linkedin}
      github={data.links.github}
    />
    <Expertise asides={data.asides} />
    <Route summary={data.routeSummary} />
    <Experience earlier={data.earlier} talks={data.talks} resume={data.resume} />
    <Contact
      statement={data.contact}
      email={data.email}
      linkedin={data.links.linkedin}
      github={data.links.github}
      resume={data.resume}
    />
  </div>
</Base>
