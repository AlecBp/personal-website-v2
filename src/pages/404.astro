---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Alec Pagliarussi" description="This page doesn't exist." noindex>
  <section class="not-found" aria-labelledby="nf-title">
    <div class="wrap grid">
      <p class="code" aria-hidden="true">404</p>
      <div>
        <h1 id="nf-title">This page doesn't exist.</h1>
        <p>It may have moved when the site was rebuilt, or the link was mistyped.</p>
        <p class="actions"><a class="btn btn--primary" href="/">Back to the homepage</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: clamp(3rem, 12vw, 8rem);
  }

  .code {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  h1 + p {
    margin-top: 1rem;
    color: var(--muted);
  }

  .actions {
    margin-top: 2rem;
  }
</style>
