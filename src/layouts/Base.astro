---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import portrait from '../assets/portrait.jpg';
import '../styles/global.css';
import themeInit from '../scripts/theme-init.js?raw';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The page is about Alec (the homepage): marks it up as a profile for social cards and search. */
  profilePage?: boolean;
}

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('src/content/profile.md is missing');
const { name, jobTitle, employer, location, alumniOf, description: defaultDescription, links } = profile.data;

const {
  title = `${name} — ${jobTitle}`,
  description = defaultDescription,
  noindex = false,
  profilePage = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://alecpagliarussi.me');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const ogImageAlt = `${name}, ${jobTitle} at ${employer}`;
const [givenName, ...rest] = name.split(' ');
const familyName = rest.join(' ');

// Structured data. Search engines read the headshot, not the text-heavy OG card, as the person's photo.
const headshot = await getImage({ src: portrait, width: 460, format: 'jpg' });
const expertise = (await getCollection('expertise')).sort((a, b) => a.data.order - b.data.order);
const personId = new URL('/#person', site).href;
const websiteId = new URL('/#website', site).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: site.href,
    name,
    alternateName: site.hostname,
    description: defaultDescription,
    inLanguage: 'en-CA',
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name,
    givenName,
    familyName,
    jobTitle,
    description: defaultDescription,
    url: site.href,
    image: {
      '@type': 'ImageObject',
      url: new URL(headshot.src, site).href,
      width: headshot.attributes.width,
      height: headshot.attributes.height,
    },
    worksFor: { '@type': 'Organization', name: employer, url: 'https://www.servicetitan.com/' },
    ...(alumniOf && { alumniOf: { '@type': 'CollegeOrUniversity', name: alumniOf } }),
    homeLocation: { '@type': 'Place', name: location },
    knowsAbout: expertise.flatMap(({ data }) => [data.title, ...(data.tech ?? [])]),
    sameAs: [links.linkedin, links.github],
  },
];

if (profilePage) {
  graph.push({
    '@type': 'ProfilePage',
    '@id': `${canonical}#profile`,
    url: canonical,
    name: title,
    inLanguage: 'en-CA',
    isPartOf: { '@id': websiteId },
    mainEntity: { '@id': personId },
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={name} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="max-image-preview:large" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111416" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href="/fonts/geist-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={profilePage ? 'profile' : 'website'} />
    {
      profilePage && (
        <>
          <meta property="profile:first_name" content={givenName} />
          <meta property="profile:last_name" content={familyName} />
        </>
      )
    }
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!--
      Resolve the theme before anything paints. It must stay synchronous, so it is inlined;
      astro.config.mjs adds its hash to the CSP. It sits in <body> so the CSP <meta> covers it.
    -->
    <script is:inline set:html={themeInit} />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header name={name} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer name={name} location={location} source={links.source} />
  </body>
</html>
