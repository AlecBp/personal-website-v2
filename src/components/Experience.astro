---
import { getCollection, render } from 'astro:content';

interface Props {
  earlier: string;
  education: string;
}

const { earlier, education } = Astro.props;

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// Group consecutive roles at the same company so promotions read as one timeline.
const companies: { name: string; roles: typeof roles }[] = [];
for (const role of roles) {
  const last = companies.at(-1);
  if (last && last.name === role.data.company) last.roles.push(role);
  else companies.push({ name: role.data.company, roles: [role] });
}

const rendered = await Promise.all(roles.map(async (role) => [role.id, (await render(role)).Content] as const));
const contentFor = new Map(rendered);
const earlierItems = earlier.split('·').map((item) => item.trim());
---

<div class="experience">
  {
    companies.map((company) => (
      <article class="company">
        <h3 class="company-name">{company.name}</h3>
        <ol class="timeline">
          {company.roles.map((role, index) => {
            const Content = contentFor.get(role.id)!;
            return (
              <li class:list={['role', { current: index === 0 && role.data.end === 'Present' }]}>
                <p class="meta dates">
                  {role.data.start} – {role.data.end}
                </p>
                <h4>{role.data.title}</h4>
                <p class="meta">
                  {[role.data.team, role.data.location].filter(Boolean).join(' · ')}
                </p>
                <div class="highlights">
                  <Content />
                </div>
                {role.data.note && <p class="meta note">{role.data.note}</p>}
              </li>
            );
          })}
        </ol>
      </article>
    ))
  }

  <div class="earlier">
    <h3 class="eyebrow">Earlier</h3>
    <ul>
      {earlierItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="earlier">
    <h3 class="eyebrow">Education</h3>
    <p>{education}</p>
  </div>
</div>

<style>
  .experience {
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.5rem);
  }

  .company-name {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .timeline {
    list-style: none;
    margin-top: 1.5rem;
    padding: 0 0 0 1.5rem;
    border-left: 1px solid var(--line);
    display: grid;
    gap: 2.25rem;
  }

  .role {
    position: relative;
  }

  /* Timeline node. The current role gets a filled accent dot. */
  .role::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 0.45em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--muted);
  }

  .role.current::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .dates {
    margin-bottom: 0.3rem;
  }

  h4 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .highlights {
    margin-top: 1rem;
  }

  .highlights :global(ul) {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .highlights :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }

  .highlights :global(li)::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .note {
    margin-top: 1rem;
    font-style: normal;
  }

  .earlier {
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .earlier h3 {
    margin-bottom: 0.75rem;
  }

  .earlier + .earlier {
    border-top: 0;
    padding-top: 0;
  }

  .earlier ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
</style>
