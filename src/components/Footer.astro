---
interface Props {
  name: string;
  location: string;
  source?: string;
}

const { name, location, source } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="site-footer">
    <p>© {year} {name}</p>
    <p>
      {location} · Built with <a href="https://astro.build/">Astro</a>, no trackers{
        source && (
          <>
            {' · '}
            <a href={source}>Source</a>
          </>
        )
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 2.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--accent);
  }

  @media print {
    a::after {
      content: none !important;
    }
  }
</style>
