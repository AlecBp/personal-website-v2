---
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="writing">
  {
    entries.map(({ data }) => (
      <li>
        <p class="title">{data.href ? <a href={data.href}>{data.title}</a> : data.title}</p>
        <p class="meta">
          {data.venue}
          {data.date && ` · ${data.date.getFullYear()}`}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .writing {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
