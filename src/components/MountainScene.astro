<script>
  // SMIL ignores prefers-reduced-motion, so pause it here. Also pause while the scene is off screen.
  // setCurrentTime(0.01) matters: without it a paused scene never draws its first frame.
  const scenes = document.querySelectorAll<SVGSVGElement>('svg[data-scene]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const visible = new Map<SVGSVGElement, boolean>();

  const sync = () => {
    scenes.forEach((scene) => {
      if (!reduce.matches && visible.get(scene) !== false) {
        scene.unpauseAnimations();
        return;
      }
      scene.pauseAnimations();
      if (scene.getCurrentTime() < 0.01) scene.setCurrentTime(0.01);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => visible.set(entry.target as SVGSVGElement, entry.isIntersecting));
    sync();
  });
  scenes.forEach((scene) => observer.observe(scene));
  reduce.addEventListener('change', sync);
  requestAnimationFrame(sync);
</script>

<style>
  .scene-wrap {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 100vw;
    height: clamp(200px, 22.5vw, 420px);
    transform: translateX(-50%);
    pointer-events: none;
    color: var(--fg);
    /* Full strength in the gutters, about 30% behind the 1240px content column. */
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(50% - 640px),
      rgb(0 0 0 / 0.3) calc(50% - 520px),
      rgb(0 0 0 / 0.3) calc(50% + 520px),
      #000 calc(50% + 640px),
      #000 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(50% - 640px),
      rgb(0 0 0 / 0.3) calc(50% - 520px),
      rgb(0 0 0 / 0.3) calc(50% + 520px),
      #000 calc(50% + 640px),
      #000 100%
    );
  }

  .scene-fade {
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }

  .scene-wrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media print {
    .scene-wrap {
      display: none;
    }
  }
</style>
