---
import EmailLink from './EmailLink.astro';

interface Props {
  statement: string;
  email: string;
  linkedin: string;
  github: string;
  resume: string;
}

const { statement, email, linkedin, github, resume } = Astro.props;
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="visually-hidden">Contact</h2>
  <p class="statement">{statement}</p>
  <p class="links">
    <EmailLink email={email} showAddress />
    <a href={linkedin} rel="me">LinkedIn</a>
    <a href={github} rel="me">GitHub</a>
    <a href={resume}>Résumé</a>
  </p>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 10vw, 8.5rem) var(--section-pad);
  }

  .statement {
    max-width: 14em;
    font-size: clamp(2rem, 1rem + 3.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.5rem;
    margin-top: 1.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }
</style>
