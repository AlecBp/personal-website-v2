---
import { getCollection } from 'astro:content';

interface Props {
  summary: string;
}

const { summary } = Astro.props;
const stops = (await getCollection('route')).sort((a, b) => a.data.order - b.data.order).map((r) => r.data);
---

<section id="route" class="section" aria-labelledby="route-title">
  <div class="head">
    <h2 id="route-title" class="section-title">The route so far</h2>
    <p class="summary">{summary}</p>
  </div>
  <!-- Horizontal line on wide screens, vertical below 60rem (eight columns get cramped on tablets); pure CSS, no JS. -->
  <ol class="route">
    {
      stops.map((stop) => (
        <li class:list={[stop.status]} aria-current={stop.status === 'current' ? 'step' : undefined}>
          <span class="dot" aria-hidden="true" />
          {stop.status === 'next' && (
            <span class="arrow" aria-hidden="true">
              →
            </span>
          )}
          <p class="year">{stop.year}</p>
          <p class="title">{stop.title}</p>
          <p class="detail">{stop.detail}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.375rem 1.5rem;
  }

  .head .section-title {
    margin-bottom: 0;
  }

  .summary {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .route {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
  }

  li {
    position: relative;
    margin-left: 4px;
    padding: 0 0 1.25rem 1.375rem;
    border-left: 1px solid var(--muted);
  }

  .dot {
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--muted);
  }

  .current .dot {
    background: var(--accent);
    border-color: var(--accent);
  }

  .next {
    padding-bottom: 1.75rem;
    border-left: 1.5px dashed var(--accent);
  }

  .next .dot {
    left: -5.75px;
    border-color: var(--accent);
  }

  .arrow {
    display: none;
  }

  .year {
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .title {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .detail {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .next .year,
  .next .title {
    color: var(--accent);
  }

  @media (min-width: 60rem) {
    .route {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      margin-top: 3.5rem;
    }

    li {
      margin-left: 0;
      padding: 1.5rem 1.125rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--muted);
    }

    .dot,
    .next .dot {
      left: 0;
      top: -5px;
    }

    .next {
      padding-bottom: 0;
      border-left: 0;
      border-top: 1.5px dashed var(--accent);
    }

    .next .dot {
      top: -5.75px;
    }

    .arrow {
      display: block;
      position: absolute;
      top: -13px;
      right: -4px;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--accent);
    }

    .detail {
      font-size: 0.84375rem;
    }
  }

  /* Printed pages use the vertical list, in two columns to save paper. */
  @media print {
    .route {
      columns: 2;
      column-gap: 2rem;
      margin-top: 1rem;
    }

    li {
      padding-bottom: 0.75rem;
      break-inside: avoid;
    }
  }
</style>
