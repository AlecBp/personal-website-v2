---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<p class="intro">Student projects from 2020, for the curious.</p>
<ul class="projects">
  {
    projects.map(({ data }) => (
      <li>
        <h3>{data.title}</h3>
        <p>
          {data.summary} <span class="stack">{data.stack}.</span>
        </p>
        <p class="links">
          {data.links.map((link, index) => (
            <>
              {index > 0 && ' · '}
              <a href={link.href}>
                {link.label}
                <span class="visually-hidden"> for {data.title}</span>
              </a>
            </>
          ))}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .intro {
    margin-bottom: 1.25rem;
  }

  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .links {
    font-family: var(--font-display);
    font-size: var(--step--1);
  }

  .links a {
    color: var(--muted);
    text-decoration-color: currentColor;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
